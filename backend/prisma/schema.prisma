// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  FEE
  INTEREST
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CardType {
  DEBIT
  CREDIT
  VIRTUAL
}

enum CardStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  EXPIRED
  LOST_STOLEN
}

enum LoanType {
  PERSONAL
  HOME
  AUTO
  EDUCATION
  BUSINESS
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  PAID_OFF
  DEFAULTED
  REJECTED
}

enum NotificationType {
  TRANSACTION
  SECURITY
  ACCOUNT
  PAYMENT
  LOAN
  GENERAL
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  address           String?
  role              Role           @default(CUSTOMER)
  isEmailVerified   Boolean        @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  twoFactorEnabled  Boolean        @default(false)
  twoFactorSecret   String?
  loginAttempts     Int            @default(0)
  lockoutUntil      DateTime?
  lastLogin         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts          Account[]
  beneficiaries     Beneficiary[]
  loans             Loan[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  fromTransactions  Transaction[]  @relation("FromUser")
  toTransactions    Transaction[]  @relation("ToUser")

  @@index([email])
}

model Account {
  id              String          @id @default(uuid())
  accountNumber   String          @unique
  accountType     AccountType
  balance         Decimal         @default(0) @db.Decimal(12, 2)
  currency        String          @default("USD")
  status          AccountStatus   @default(ACTIVE)
  userId          String
  availableBalance Decimal?       @db.Decimal(12, 2)
  creditLimit     Decimal?        @db.Decimal(12, 2)
  interestRate    Decimal?        @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards           Card[]
  fromTransactions Transaction[]  @relation("FromAccount")
  toTransactions  Transaction[]  @relation("ToAccount")

  @@index([userId])
  @@index([accountNumber])
}

model Transaction {
  id              String            @id @default(uuid())
  fromAccountId   String?
  toAccountId     String?
  fromUserId      String?
  toUserId        String?
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  reference       String?           @unique
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fromAccount     Account?          @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account?          @relation("ToAccount", fields: [toAccountId], references: [id])
  fromUser        User?             @relation("FromUser", fields: [fromUserId], references: [id])
  toUser          User?             @relation("ToUser", fields: [toUserId], references: [id])

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([createdAt])
  @@index([type])
}

model Beneficiary {
  id              String    @id @default(uuid())
  userId          String
  name            String
  accountNumber   String
  bankName        String
  bankCode        String?
  swiftCode       String?
  iban            String?
  nickname        String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Card {
  id              String      @id @default(uuid())
  accountId       String
  cardNumber      String      @unique  // Note: Should be encrypted/tokenized in production
  cardType        CardType
  expiryDate      DateTime
  cardholderName  String
  status          CardStatus  @default(INACTIVE)
  spendingLimit   Decimal?    @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([cardNumber])
}

model Loan {
  id              String      @id @default(uuid())
  userId          String
  loanType        LoanType
  amount          Decimal     @db.Decimal(12, 2)
  interestRate    Decimal     @db.Decimal(5, 2)
  term            Int
  monthlyPayment  Decimal     @db.Decimal(12, 2)
  remainingAmount Decimal     @db.Decimal(12, 2)
  status          LoanStatus  @default(PENDING)
  startDate       DateTime?
  endDate         DateTime?
  nextPaymentDate DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id              String            @id @default(uuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  isRead          Boolean           @default(false)
  metadata        Json?
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id              String    @id @default(uuid())
  userId          String?
  action          String
  entity          String?
  entityId        String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
